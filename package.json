{
  "name": "promise-jewels",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Promise Jewels — website, admin panel and API in one project, served by a single Node server.",
  "scripts": {
    "dev": "tsx watch server/src/server.ts",
    "build": "prisma generate && vite build && tsc -p server/tsconfig.json",
    "start": "cross-env NODE_ENV=production node server/dist/server.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/src/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx server/prisma/seed.ts",
    "rbac:check": "tsx server/src/modules/rbac/rbac.selftest.ts",
    "rbac:coverage": "tsx server/src/modules/rbac/rbac.coverage.ts",
    "rbac:e2e": "tsx server/src/modules/rbac/rbac.e2e.ts",
    "otp:check": "tsx server/src/modules/auth/otp-policy.selftest.ts",
    "db:studio": "prisma studio",
    "dev:preview": "cross-env PJ_NO_WATCH=1 tsx server/src/server.ts",
    "vault:check": "tsx server/src/modules/secure-notes/secure-notes.selftest.ts",
    "error:check": "tsx server/src/middleware/error.middleware.selftest.ts",
    "ops:check": "node server/src/modules/exhibition-ops/exhibition-ops.e2e.mjs",
    "security:harden": "tsx server/src/scripts/harden.ts",
    "security:check": "tsx server/src/scripts/securityCheck.ts"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "main": "server/dist/server.js",
  "//engines": [
    "22, not 20. @supabase/supabase-js and sanitize-html both declare",
    "node >=22, and the managed host picks its Node version from this field —",
    "with >=20 it chose 20.19.4 and installed them on an engine they do not",
    "support, which npm reports as a warning and the runtime would discover",
    "later and less clearly."
  ],
  "engines": {
    "node": ">=22"
  },
  "//overrides": [
    "Transitive dependency pins, mirrored from pnpm-workspace.yaml.",
    "Both files must say the same thing. pnpm 11 reads the workspace file and",
    "ignores this block; npm reads this block and ignores the workspace file.",
    "Production installs on the managed host run under npm (its build image has",
    "no pnpm - corepack cannot fetch one), so without this the qs advisory pin",
    "silently disappears in production while still holding in local development.",
    "",
    "GHSA-4mjr-xmp4-gh2g  qs - denial of service via attacker-controlled isBuffer",
    "deepmerge-ts - stack exhaustion on deeply recursive merges",
    "effect - AsyncLocalStorage context lost/contaminated"
  ],
  "overrides": {
    "qs": ">=6.16.0",
    "deepmerge-ts": ">=8.0.0",
    "effect": ">=3.20.0"
  },
  "dependencies": {
    "@prisma/client": "6.16.3",
    "@supabase/supabase-js": "^2.112.0",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-font-family": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bullmq": "^6.0.9",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.28.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prisma": "6.16.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "5.8.3",
    "vite": "^8.2.0"
  }
}
