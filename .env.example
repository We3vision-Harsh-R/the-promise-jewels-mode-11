# Copy to .env and fill in. .env is gitignored — never commit real values.

NODE_ENV=development
PORT=2000

SITE_NAME=Promise Jewels
SITE_URL=http://localhost:2000
FRONTEND_URL=http://localhost:2000
DEFAULT_OG_IMAGE=/images/default-og.png

# Postgres, from Supabase > Project Settings > Database > Connect.
#
# Use the SESSION pooler (port 5432) for BOTH urls. This app is one long-running
# Node process, not a serverless function, and the session pooler answers about
# five times faster than the transaction pooler (port 6543): measured on the same
# database, 0.38 s per query against 1.83 s. The transaction pooler needs
# ?pgbouncer=true and makes Prisma talk to the database several times per query;
# that is worth it for serverless, and costs a lot here.
#
# connection_limit=5 lets a handful of queries run at once (the default of one
# made every request queue behind the one before it). The session pooler allows
# 15 connections on the free plan, so five leaves room for migrations.
#
# Use the pooler hosts, not the "Direct connection" string Supabase shows:
# db.<ref>.supabase.co resolves to IPv6 only and is unreachable from an
# IPv4-only network.
#
# Also pick the Supabase REGION nearest your visitors and your host when the
# project is created — it cannot be changed afterwards, and every query pays for
# the distance. Mumbai (ap-south-1) for visitors in India.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=5&pool_timeout=20
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase is used for FILE STORAGE only. The browser never talks to it —
# every read and write goes through this API — so no publishable/anon key is
# needed and there is no client-side Supabase client in src/.
# The secret key bypasses row-level security: server-side only, and never in
# a VITE_ variable (those are inlined into the public JS bundle).
# Take the `sb_secret_...` value from Supabase > Project Settings > API Keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10
PRISMA_CLIENT_ENGINE_TYPE=library

# First admin account. Read only by `db:seed`, and only when that account does
# not exist yet. Use a strong password and never commit it.
SEED_ADMIN_PASSWORD=

# Login OTP email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=Promise Jewels <onboarding@resend.dev>
OTP_EXPIRY_MINUTES=5

# false = use the real API; true = use the mock data in src/services/mock
VITE_USE_MOCK=false

# ---- The vault (Admin > System > Vault) ----------------------------------
# Notes and passwords are sealed with AES-256-GCM before they reach the
# database, and this is the key. 32 bytes, base64.
#
# Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# KEEP A COPY SOMEWHERE SAFE AND OFFLINE. There is no recovery: lose the key
# and every note sealed with it is unreadable forever, including from backups.
# Changing it has the same effect as losing it — existing notes will not open
# under a new key.
#
# Without it the site still runs; only the vault refuses to open, with a
# message saying why.
NOTES_ENCRYPTION_KEY=

# ---- Database pooling -----------------------------------------------------
# See the note above DATABASE_URL: session pooler, port 5432, connection_limit=5.
# If you see "Timed out fetching a new connection from the connection pool"
# (P2024) the limit is too low for the traffic; raise it, but stay under the
# pooler's own limit (15 on the free plan).

# ---- Personal data at rest ------------------------------------------------
# Enquiry contact details and exhibition leads are encrypted per column before
# they reach Postgres (AES-256-GCM, see server/src/utils/fieldCrypto.ts), so a
# database dump carries no names, phone numbers or messages.
#
# Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# SEPARATE FROM NOTES_ENCRYPTION_KEY on purpose: one protects the owner's own
# passwords, the other protects customers' contact details, and compromising
# one should not compromise both.
#
# KEEP A COPY SOMEWHERE SAFE AND OFFLINE. There is no recovery.
DATA_ENCRYPTION_KEY=

# ---- Who may reach the admin panel ------------------------------------------
# Comma-separated list of addresses (or IPv4 ranges like 203.0.113.0/24) that may
# open /admin and use the private API. Anyone else is told it does not exist; the
# public website is unaffected. Leave it empty and the panel is open to anyone who
# knows the address (password + emailed code still apply).
#
# Put the real addresses ONLY in the host's environment — never in a file that is
# committed. 'npm run security:check' fails if a listed address appears in the repo.
#
# ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.0/24
#
# More addresses can be added later, without a redeploy, in the admin panel
# (Settings > Admin access). The ones HERE are permanent: that screen cannot
# remove them, so they are the way back in after a mistake. Put the one or two
# addresses that must never be locked out here.
#
# ADMIN_IP_GUARD=off   switches the whole protection off, whatever is saved in the
#                      panel. The last resort if every listed address stops working.
#
# "report" logs who WOULD be refused and refuses nobody — use it for the first
# deploy, then switch to "enforce" (the default) once the log shows no surprises.
# ADMIN_IP_MODE=enforce

# ---- Network ---------------------------------------------------------------
# How many reverse proxies / load balancers / CDNs sit between the visitor and
# this app and add themselves to X-Forwarded-For. 1 for a normal host (the
# default). Use 2 for "CDN + load balancer", and so on. Wrong values make every
# visitor look like the proxy: shared rate limits, one country on the map.
# TRUST_PROXY_HOPS=1

# ---- Keeping Supabase awake -----------------------------------------------
# A free-tier project pauses after ~7 days with no DATABASE activity. The app
# runs one trivial query a day to prevent it (server/src/jobs/keepAlive.ts),
# and supabase/keep-alive.mjs does the same from the host's cron for when the
# app is not running. See supabase/README.md.
#
# Hours between pings. Leave unset for the default of 24. A non-positive
# number disables the in-process timer.
KEEPALIVE_INTERVAL_HOURS=24
