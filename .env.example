# Copy to .env and fill in. .env is gitignored — never commit real values.

NODE_ENV=development
PORT=2000

SITE_NAME=Promise Jewels
SITE_URL=http://localhost:2000
FRONTEND_URL=http://localhost:2000
DEFAULT_OG_IMAGE=/images/default-og.png

# Postgres, from Supabase > Project Settings > Database.
# DATABASE_URL is the transaction pooler (port 6543) the app runs on —
# ?pgbouncer=true is required there because that pooler cannot hold prepared
# statements. DIRECT_URL is the session pooler (port 5432) that `db push` and
# migrations use, and it must NOT carry that flag.
#
# Use the pooler hosts, not the "Direct connection" string Supabase shows:
# db.<ref>.supabase.co resolves to IPv6 only and is unreachable from an
# IPv4-only network.
DATABASE_URL=
DIRECT_URL=

# Supabase is used for FILE STORAGE only. The browser never talks to it —
# every read and write goes through this API — so no publishable/anon key is
# needed and there is no client-side Supabase client in src/.
# The secret key bypasses row-level security: server-side only, and never in
# a VITE_ variable (those are inlined into the public JS bundle).
# Take the `sb_secret_...` value from Supabase > Project Settings > API Keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10
PRISMA_CLIENT_ENGINE_TYPE=library

# First admin account. Read only by `db:seed`, and only when that account does
# not exist yet. Use a strong password and never commit it.
SEED_ADMIN_PASSWORD=

# Login OTP email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=Promise Jewels <onboarding@resend.dev>
OTP_EXPIRY_MINUTES=5

# false = use the real API; true = use the mock data in src/services/mock
VITE_USE_MOCK=false

# ---- The vault (Admin > System > Vault) ----------------------------------
# Notes and passwords are sealed with AES-256-GCM before they reach the
# database, and this is the key. 32 bytes, base64.
#
# Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# KEEP A COPY SOMEWHERE SAFE AND OFFLINE. There is no recovery: lose the key
# and every note sealed with it is unreadable forever, including from backups.
# Changing it has the same effect as losing it — existing notes will not open
# under a new key.
#
# Without it the site still runs; only the vault refuses to open, with a
# message saying why.
NOTES_ENCRYPTION_KEY=

# ---- Database pooling -----------------------------------------------------
# The pooled URL (port 6543, Supabase's transaction-mode pooler) MUST pin a
# connection limit. Without one Prisma opens (cpu cores * 2 + 1) connections —
# 25 on a 12-core machine — against a pooler that allows far fewer per client.
# The symptom is intermittent, gets worse the longer the server runs, and
# reads as two different faults:
#   P2024 Timed out fetching a new connection from the connection pool
#   Can't reach database server at ...:6543
# The pooler is already doing the pooling, so one connection per client is the
# documented setting:
#   DATABASE_URL="postgresql://...:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20"
#
# DIRECT_URL keeps port 5432 (no pooler) — migrations need a real session.

# ---- Personal data at rest ------------------------------------------------
# Enquiry contact details and exhibition leads are encrypted per column before
# they reach Postgres (AES-256-GCM, see server/src/utils/fieldCrypto.ts), so a
# database dump carries no names, phone numbers or messages.
#
# Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# SEPARATE FROM NOTES_ENCRYPTION_KEY on purpose: one protects the owner's own
# passwords, the other protects customers' contact details, and compromising
# one should not compromise both.
#
# KEEP A COPY SOMEWHERE SAFE AND OFFLINE. There is no recovery.
DATA_ENCRYPTION_KEY=

# ---- Keeping Supabase awake -----------------------------------------------
# A free-tier project pauses after ~7 days with no DATABASE activity. The app
# runs one trivial query a day to prevent it (server/src/jobs/keepAlive.ts),
# and supabase/keep-alive.mjs does the same from the host's cron for when the
# app is not running. See supabase/README.md.
#
# Hours between pings. Leave unset for the default of 24. A non-positive
# number disables the in-process timer.
KEEPALIVE_INTERVAL_HOURS=24
