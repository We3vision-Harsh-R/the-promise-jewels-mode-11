generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String        @id @default(uuid())
  name             String
  email            String        @unique
  password         String
  isActive         Boolean       @default(true)
  isOtpVerified    Boolean       @default(false)
  otpCode          String?
  otpExpiresAt     DateTime?
  otpPurpose       OtpPurpose?
  refreshTokenHash String?
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  otpAttempts      Int           @default(0)
  role             UserRole      @default(ADMIN)
  /// The role this account holds. Nullable on purpose: an account with no
  /// role has no permissions, which is the right answer for one created
  /// before its role was decided, and for every account that existed before
  /// RBAC did.
  roleId           String?
  roleRef          Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)

  brands           brands[]
  collections      collections[]
  exhibitions      exhibitions[]
  announcements    Announcement[] @relation("AnnouncementAuthor")
  notifications    Notification[]
  secureNotes      SecureNote[]


  @@map("users")
}

model ActivityLog {
  id        String   @id
  action    String
  module    String
  details   String
  userName  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model brand_images {
  id           String   @id
  brandId      String
  imageUrl     String
  altText      String?
  caption      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  brands       brands   @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model brands {
  id            String         @id
  name          String
  slug          String         @unique
  description   String
  overview      String?
  logoUrl       String?
  bannerUrl     String?
  ctaTitle      String?
  ctaButtonText String?
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  brand_images  brand_images[]
  users         User           @relation(fields: [createdBy], references: [id])
  collections   collections[]
}

model cms_pages {
  id          String   @id
  pageName    String   @unique
  title       String
  content     String
  bannerImage String?
  isPublished Boolean  @default(false)
  updatedAt   DateTime
}

model collection_images {
  id           String      @id
  collectionId String
  imageUrl     String
  altText      String?
  caption      String?
  displayOrder Int         @default(0)
  isThumbnail  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  collections  collections @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

model collections {
  id                String              @id
  brandId           String
  name              String
  slug              String              @unique
  description       String
  category          String?
  bannerUrl         String?
  specification     String?
  ctaTitle          String?
  ctaButtonText     String?
  featured          Boolean             @default(false)
  displayOrder      Int                 @default(0)
  isActive          Boolean             @default(true)
  createdBy         String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  collection_images collection_images[]
  brands            brands              @relation(fields: [brandId], references: [id])
  users             User                @relation(fields: [createdBy], references: [id])

  /// Lines on a show's stock list that point at this collection.
}

model exhibition_images {
  id           String      @id @default(uuid())
  exhibitionId String
  imageUrl     String
  altText      String?
  caption      String?
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  exhibitions  exhibitions @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
}

model exhibitions {
  id                  String                @id @default(uuid())
  title               String
  slug                String                @unique
  thumbnailUrl        String?
  description         String
  venue               String
  city                String?
  country             String?
  startDate           DateTime
  endDate             DateTime
  featured            Boolean               @default(false)
  isActive            Boolean               @default(true)
  createdBy           String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  year                Int?
  edition             String?
  organiser           String?
  audience            String?
  hours               String?
  whyWeExhibit        String?
  highlights          Json?
  venues              Json?
  datesConfirmed      Boolean               @default(true)
  customSections      Json?
  exhibition_images   exhibition_images[]
  exhibition_sections exhibition_sections[]
  users               User                  @relation(fields: [createdBy], references: [id])
}

/// One operator-defined block on a show — renders as its own headed section on
/// the public page. Real rows rather than a Json blob so the content can be
/// queried, ordered and cascade-deleted like everything else.
model exhibition_sections {
  id           String                      @id @default(uuid())
  exhibitionId String
  title        String
  displayOrder Int                         @default(0)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  fields       exhibition_section_fields[]
  exhibitions  exhibitions                 @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  @@index([exhibitionId])
}

/// One labelled line inside a section. `value` is a String, which Prisma maps
/// to Postgres `text`, so there is no column-level length limit — the cap in
/// exhibition.validation.ts is the one that applies.
model exhibition_section_fields {
  id           String              @id @default(uuid())
  sectionId    String
  label        String
  value        String
  displayOrder Int                 @default(0)
  createdAt    DateTime            @default(now())
  section      exhibition_sections @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model inquiries {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
}

model settings {
  id            String   @id
  siteName      String
  logoUrl       String?
  faviconUrl    String?
  email         String?
  phone         String?
  address       String?
  facebookUrl   String?
  instagramUrl  String?
  linkedinUrl   String?
  youtubeUrl    String?
  updatedAt     DateTime
  businessHours String?

  /// Whether signing in needs the emailed one-time code as a second step.
  ///
  /// Defaults to FALSE. The panel is useless to a locked-out administrator,
  /// and OTP delivery depends on a mail sender that is easy to get wrong —
  /// so the safe default is the one that cannot lock anybody out. Turn it on
  /// from Settings once mail is known to arrive.
  otpRequired   Boolean  @default(false)
}

model team_members {
  id           String   @id
  name         String
  designation  String
  bio          String?
  photoUrl     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  /// "leader" (Our Leaders) or "team" (Meet Our Team) on the About page.
  kind         String   @default("leader")
  /// Which company the person belongs to: "promise-jewels" or "netram".
  category     String   @default("promise-jewels")
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model SeoSettings {
  id                     String       @id @default(cuid())
  siteName               String
  siteUrl                String
  defaultMetaTitle       String
  defaultMetaDescription String
  defaultOgImage         String?
  robots                 RobotsPolicy @default(INDEX_FOLLOW)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@map("seo_settings")
}

model SeoPage {
  id                 String                  @id @default(cuid())
  slug               String                  @unique
  entityType         SeoEntityType
  entityId           String?
  metaTitle          String
  metaDescription    String
  canonicalUrl       String?
  robots             RobotsPolicy            @default(INDEX_FOLLOW)
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?
  schemaType         SchemaType?
  priority           Float?                  @default(0.5)
  changeFrequency    SitemapChangeFrequency?
  includeInSitemap   Boolean                 @default(true)
  isIndexed          Boolean                 @default(true)
  isPublished        Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  displayName        String
  tags               SeoPageTag[]

  @@map("seo_pages")
}

model SeoTag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  pages     SeoPageTag[]

  @@map("seo_tags")
}

model SeoPageTag {
  seoPageId String
  seoTagId  String
  seoPage   SeoPage @relation(fields: [seoPageId], references: [id], onDelete: Cascade)
  seoTag    SeoTag  @relation(fields: [seoTagId], references: [id], onDelete: Cascade)

  @@id([seoPageId, seoTagId])
  @@map("seo_page_tags")
}

/// Uploaded image library for the site's CMS-managed sections.
/// One row per uploaded file. Files live in the Supabase "cms" bucket;
/// storagePath is kept so the object can be removed when the row is deleted.
model media_assets {
  id            String           @id @default(uuid())
  url           String
  storagePath   String
  fileName      String
  mimeType      String
  fileSize      Int
  createdAt     DateTime         @default(now())
  sectionImages section_images[]
}

/// Which library image is currently published into which numbered frame of a
/// page section. The public site reads this table, so writing/deleting a row
/// here is what makes an image appear on or disappear from the website.
///
/// `slot` is the frame number the admin panel shows (1..section.slots, going
/// clockwise from the top of the ring). It is the image's identification
/// number: one row per frame, so replacing frame 7 never disturbs frame 8.
/// The same library image may fill several slots, so there is deliberately no
/// unique constraint on assetId.
model section_images {
  id        String       @id @default(uuid())
  section   String
  assetId   String
  createdAt DateTime     @default(now())
  slot      Int
  updatedAt DateTime     @updatedAt
  asset     media_assets @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([section, slot])
  @@index([section, slot])
}

/// Editable copy for the public website, one row per overridden string.
///
/// Key/value rather than a column per field: which strings are editable is
/// declared in code (page-content.constants.ts), so adding an editable
/// heading is a code change and never a migration. A field with no row here
/// falls back to the copy bundled with the site, which is why an empty table
/// renders every page exactly as it shipped.
model page_content {
  id        String   @id @default(uuid())
  page      String
  section   String
  field     String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([page, section, field])
  @@index([page])
}

model blog_comments {
  id         String     @id @default(cuid())
  postId     String
  name       String
  email      String?
  body       String
  status     String     @default("pending")
  createdAt  DateTime   @default(now())
  post       blog_posts @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, status])
  @@index([status, createdAt])
}

model blog_posts {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  excerpt         String?
  content         String
  coverUrl        String?
  authorName      String?
  tags            String[]        @default([])
  status          String          @default("draft")
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  canonicalUrl    String?
  noindex         Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  comments        blog_comments[]

  @@index([slug])
  @@index([status, publishedAt])
}

enum OtpPurpose {
  LOGIN
  FORGOT_PASSWORD
}

enum InquiryStatus {
  NEW
  READ
}

enum SeoEntityType {
  STATIC_PAGE
  BRAND
  COLLECTION
  EXHIBITION
  BLOG
  PRODUCT
  LOCATION
}

enum RobotsPolicy {
  INDEX_FOLLOW
  INDEX_NOFOLLOW
  NOINDEX_FOLLOW
  NOINDEX_NOFOLLOW
}

enum SitemapChangeFrequency {
  ALWAYS
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  NEVER
}

enum SchemaType {
  WEBSITE
  ORGANIZATION
  BRAND
  EXHIBITION
  COLLECTION
  EVENT
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

// ---------------------------------------------------------------------------
// RBAC
//
// A role is a named bundle of permissions; a user holds exactly one. The
// permissions themselves are rows rather than a JSON blob so that "which roles
// can delete a brand" is a query rather than a scan, and so a permission that
// no longer exists in the catalogue can be found and cleaned up.
//
// Nothing here is nullable-by-accident: a user without a role has no
// permissions at all, which is the correct answer for an account created
// before its role was decided.
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  /// The master role. Cannot be renamed, deleted, or stripped of permissions,
  /// and always passes a permission check — see permissions.catalog.ts.
  isSystem    Boolean  @default(false)

  permissions RolePermission[]
  users       User[]
  targetedBy  AnnouncementTarget[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model RolePermission {
  id       String @id @default(uuid())
  roleId   String
  /// A key from RESOURCES in permissions.catalog.ts.
  resource String
  /// One of ACTIONS. Stored apart from the resource so a role's grants can be
  /// read back grouped by screen without parsing strings.
  action   String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([roleId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Declarations and the notifications they produce
//
// A declaration is written once and addressed to one or more roles. The
// notification rows are fanned out at the moment it is published, rather than
// resolved on read, for two reasons: who held a role at the time of writing is
// the audience that was intended, and a per-user row is what gives each
// recipient their own read state.
// ---------------------------------------------------------------------------

model Announcement {
  id       String @id @default(uuid())
  title    String
  body     String

  authorId String
  author   User   @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  targets       AnnouncementTarget[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@map("announcements")
}

model AnnouncementTarget {
  id             String @id @default(uuid())
  announcementId String
  roleId         String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([announcementId, roleId])
  @@index([roleId])
  @@map("announcement_targets")
}

model Notification {
  id             String    @id @default(uuid())
  userId         String
  announcementId String
  readAt         DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, announcementId])
  @@index([userId, readAt])
  @@map("notifications")
}

/// The order sections appear in on a page, and whether each one appears at all.
///
/// A row per (page, section). Absent rows are not an error: a section the
/// catalogue declares but nobody has reordered simply falls back to its
/// declaration order and to visible. That means this table starts empty and
/// every page renders exactly as it did before anyone touched the layout.
/// The vault: notes and passwords the owner keeps in the panel.
///
/// Everything a person typed lives in `payload` as ONE sealed blob —- the
/// title, the body, the username, the password, the kind of note it is, its
/// tags. Nothing readable is stored beside it.
///
/// That is deliberate and it is stricter than it needs to be for the
/// password alone. A column of readable titles is a map of what the vault
/// holds: "HDFC net banking", "GST portal", "Tally licence" tells an
/// attacker where to spend their time even if every password stays sealed.
/// A column saying `kind = credential` says how many passwords are in here.
/// So the only things in the clear are the ones the database itself needs
/// to do its job: who owns the row, when it changed, and whether it is
/// pinned. Filtering and search happen after decryption, in the API — a
/// vault holds tens of rows, not millions.
///
/// See server/src/utils/secureBox.ts for the sealing, and
/// secure-notes.service.ts for why even the Master role cannot read these.
model SecureNote {
  id      String @id @default(uuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// Opaque. "v1.<iv>.<tag>.<ciphertext>", all base64 — see secureBox.ts.
  payload String

  /// In the clear because ordering needs it, and because "one of these is
  /// pinned" tells an attacker nothing.
  pinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, pinned, updatedAt])
  @@map("secure_notes")
}

/// A section an admin designed in the panel rather than a developer in code.
///
/// The declared sections (page-content.constants.ts) are React components with
/// their own animations; these are built from a short list of blocks — a
/// heading, a paragraph, a picture, a button — and rendered by one component
/// that reads this row. That is the trade: a custom section cannot do anything
/// a bespoke component can, but it can be created, placed and removed without
/// a deploy, which is the whole point.
///
/// `blocks` and `style` are JSON because their shape is the design itself.
/// Columns for "the third block's letter spacing" is not a schema, it is a
/// spreadsheet. Both are validated against a Zod schema on the way in, so what
/// is stored is never arbitrary.
model CustomSection {
  id    String @id @default(uuid())
  /// Which page it belongs to — a key from CONTENT_PAGES.
  page  String
  /// Its key in the arrangement. Prefixed "custom-" so a declared section and
  /// a designed one can never collide, whatever anyone names it.
  sectionKey String
  label String
  blocks Json
  style  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, sectionKey])
  @@index([page])
  @@map("custom_sections")
}

model PageSection {
  id         String  @id @default(uuid())
  /// A key from CONTENT_PAGES — "home", "about".
  page       String
  /// A section key within that page — "hero", "welcome".
  sectionKey String
  /// Ascending. Gaps are fine; only the relative order is read.
  position   Int
  isVisible  Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([page, sectionKey])
  @@index([page, position])
  @@map("page_sections")
}

model VisitorSession {
  id          String   @id
  /// ISO 3166-1 alpha-2, e.g. "IN". Null when the address could not be placed.
  country     String?
  currentPage String
  referrer    String?
  /// "mobile" | "tablet" | "desktop"
  device      String
  pageViews   Int      @default(1)
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@index([lastSeen])
  @@index([firstSeen])
  @@index([country])
  @@map("visitor_sessions")
}

model VisitorPageView {
  id        Int      @id @default(autoincrement())
  sessionId String
  page      String
  country   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([page])
  @@map("visitor_page_views")
}

// ---------------------------------------------------------------------------
// Admin access
//
// Which addresses may open the admin panel — the list the admin network guard
// (middleware/adminNetwork.middleware.ts) enforces — edited from Admin > Admin
// access instead of the host's settings. The list in the host's environment
// (ADMIN_ALLOWED_IPS) is a separate, permanent baseline that this screen cannot
// remove: it is the way back in if a mistake here locks everyone out.
// ---------------------------------------------------------------------------

model AdminAccessRule {
  id        String   @id @default(uuid())
  /// "203.0.113.10", "203.0.113.0/24" or an IPv6 address.
  address   String   @unique
  label     String
  createdBy String?
  createdAt DateTime @default(now())

  @@map("admin_access_rules")
}

model AdminAccessSettings {
  /// Always "default": there is one row.
  id        String   @id
  /// False until someone turns the protection on.
  enabled   Boolean  @default(false)
  /// "report" logs who would be refused and refuses nobody; "enforce" refuses.
  mode      String   @default("report")
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("admin_access_settings")
}
